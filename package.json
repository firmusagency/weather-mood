{
  "name": "weather-mood",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Weather-aware day-trip recommendations for hotels and tourism businesses (MVP: Chania, Crete)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "snapshot:fetch": "tsx scripts/fetch-snapshot.ts",
    "report": "tsx scripts/report.ts",
    "demo:page": "vite build --mode single && node scripts/export-demo.mjs index",
    "demo:guest": "ENTRY=guest vite build --mode single && node scripts/export-demo.mjs guest",
    "verify": "tsx scripts/verify.ts"
  },
  "dependencies": {
    "qrcode-generator": "^1.4.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "tsx": "^4.20.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-singlefile": "^2.2.0",
    "vitest": "^3.2.0"
  }
}
